# --- Project Specific (Backend Data) ---
# Database (SQLite)
*.db
*.sqlite3

# User Uploads (Private PDFs/PPTs)
# Keeps the folder structure but ignores files inside
backend/uploads/*
!backend/uploads/.gitkeep

# AI/Vector Data (FAISS Index & Metadata)
# We don't want to push the vector database
backend/data/
faiss_index.bin
metadata.pkl

# Local Large Language Models (GGUF files are huge!)
# This is crucial so you don't try to push a 4GB file to GitHub
backend/models/
*.gguf
*.bin

# Environment Variables (Security Risk!)
.env
backend/.env
frontend/.env

# --- Python (Backend) ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.python-version
.coverage
htmlcov/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Frontend (React) ---
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.eslintcache
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnp.*

# --- Editor & OS System Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini